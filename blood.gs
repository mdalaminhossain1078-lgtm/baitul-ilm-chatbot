const SHEET_ID='1IlCSfHWD-I1UGJHKs7Is7XWKpE3Lyg7A1HtClVtuGcg';const ADMIN_EMAIL='mdalaminhossain1078@gmail.com';function doGet(e){const a=e.parameter.action;if(a==='getDonors')return getDonors(e.parameter.blood);if(a==='getCount')return getCount();return ContentService.createTextOutput('OK');}function doPost(e){const d=JSON.parse(e.postData.contents);if(d.action==='addDonor')return addDonor(d);if(d.action==='bloodRequest')return bloodRequest(d);}function getDonors(b){const s=SpreadsheetApp.openById(SHEET_ID).getSheets()[0];const r=s.getDataRange().getValues();let d=[];for(let i=1;i<r.length;i++){if(!b||r[i][1]===b)d.push({name:r[i][0],blood:r[i][1],phone:r[i][2],area:r[i][3]});}return ContentService.createTextOutput(JSON.stringify(d)).setMimeType(ContentService.MimeType.JSON);}function getCount(){const s=SpreadsheetApp.openById(SHEET_ID).getSheets()[0];const r=s.getDataRange().getValues();const c={};for(let i=1;i<r.length;i++){const b=r[i][1];if(b)c[b]=(c[b]||0)+1;}return ContentService.createTextOutput(JSON.stringify(c)).setMimeType(ContentService.MimeType.JSON);}function addDonor(d){SpreadsheetApp.openById(SHEET_ID).getSheets()[0].appendRow([d.name,d.blood,d.phone,d.area,new Date().toLocaleDateString('bn-BD')]);return ContentService.createTextOutput('OK');}function bloodRequest(d){MailApp.sendEmail({to:ADMIN_EMAIL,subject:'রক্তের অনুরোধ-'+d.blood,body:'নাম:'+d.patientName+' ফোন:'+d.phone+' হাসপাতাল:'+d.hospital});return ContentService.createTextOutput('OK');}
